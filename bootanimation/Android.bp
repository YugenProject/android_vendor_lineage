// Yugen ships a finished bootanimation.zip (1080x2400 @ 24fps) instead of the
// LineageOS frame tar, so the generator and its resampling step are dropped.
prebuilt_media {
    name: "bootanimation.zip",
    src: "bootanimation.zip",
    product_specific: true,
}

install_symlink {
    name: "bootanimation-dark.zip",
    product_specific: true,
    installed_location: "media/bootanimation-dark.zip",
    symlink_target: "bootanimation.zip",
}
